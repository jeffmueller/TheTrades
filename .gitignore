.DS_Store

# Local build configuration: bundle ID prefix, DEVELOPMENT_TEAM, TMDB token.
# Create it with: cp Config/Local.example.xcconfig Config/Local.xcconfig
Config/Local.xcconfig

# Legacy: superseded by Config/Local.xcconfig + TMDBConfiguration.swift.
# Kept so a stale local copy can never be committed.
TheTrades/App/Secrets.swift

