# Copy to scripts/release.env (gitignored) and fill in your own values.
#
# Create the key in App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API -> "+". Give it the "App Manager" role. The .p8 file
# downloads exactly once, so save it somewhere permanent; the conventional
# home is ~/.appstoreconnect/private_keys/.
#
# ASC_KEY_PATH must be an absolute path.

export ASC_KEY_ID="ABCD123456"
export ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
export ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_ABCD123456.p8"

# Your 10-character Apple Developer Team ID (App Store Connect -> Users and
# Access -> Membership details). scripts/testflight.sh generates the export
# options plist from this, so no Team ID is committed to the repo.
export ASC_TEAM_ID="ABCDE12345"
