// Build settings for the TheTradesTests unit-test bundle.
//
// The test bundle needs its own identifier: PRODUCT_BUNDLE_IDENTIFIER is
// required whenever GENERATE_INFOPLIST_FILE is on, and it must not collide
// with the app's.
TT_BUNDLE_ID_PREFIX = com.example
PRODUCT_BUNDLE_IDENTIFIER = $(TT_BUNDLE_ID_PREFIX).TheTradesTests

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

#include? "Local.xcconfig"
